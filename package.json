{
  "name": "@enerjizeit/opencode-session-manager",
  "version": "2.0.2",
  "description": "Never lose an opencode AI conversation — pin, back up, restore & auto-cleanup sessions, via natural language.",
  "type": "module",
  "main": "dist/plugin.js",
  "exports": {
    ".": {
      "import": "./dist/plugin.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && mkdir -p dist && bun build session-manager.ts --outfile dist/plugin.js --target node --format esm --external @opencode-ai/plugin --external @opencode/plugin",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "session-manager",
    "session",
    "backup",
    "restore",
    "memory",
    "ai-agent",
    "persistence",
    "chat-history",
    "agent"
  ],
  "author": "EnerJizeIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EnerJizeIT/opencode-session-manager.git"
  },
  "homepage": "https://github.com/EnerJizeIT/opencode-session-manager#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.3.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/bun": "^1.3.8",
    "@opencode/plugin": "^2.2.2"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.17.0 <2",
    "@opencode/plugin": ">=2.0.18 <3"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opencode/plugin": {
      "optional": true
    }
  },
  "opencode": {
    "type": "plugin"
  },
  "files": [
    "dist",
    "package.json"
  ]
}
